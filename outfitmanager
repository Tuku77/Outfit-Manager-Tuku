local function carregarConfigOutfit()
    if g_resources.fileExists(STORAGE_DIRECTORY_OUTFIT) then
        local status, result = pcall(function() return json.decode(g_resources.readFileContents(STORAGE_DIRECTORY_OUTFIT)) end)
        if status and type(result) == "table" then
            for k, v in pairs(storageProfilesOutfit) do if result[k] == nil then result[k] = v end end
            storageProfilesOutfit = result
        end
    end
end
local function salvarConfigOutfit() pcall(function() g_resources.writeFileContents(STORAGE_DIRECTORY_OUTFIT, json.encode(storageProfilesOutfit, 2)) end) end
