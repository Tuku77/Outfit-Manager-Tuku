local mode = "gallery"

function refreshGrid()
    outfitInterface.itemScrollPanel:destroyChildren()
    local ids = {}
    if mode == "gallery" then for i = 1, maxOutfits do if not (i >= auraStart and i <= auraEnd) then table.insert(ids, i) end end
    elseif mode == "auras" then for i = auraStart, auraEnd do table.insert(ids, i) end
    else for _, v in ipairs(storageProfilesOutfit.favoritos) do table.insert(ids, v.id) end end
    
    for _, id in ipairs(ids) do
        local w = UI.createWidget("TukuStudioWidget", outfitInterface.itemScrollPanel)
        w.creature:setOutfit({type = id, addons = 3})
        w.txtId:setText("ID: " .. id)
        w.btnFav:setText(isFavorito(id) and "-" or "+")
        w.select.onClick = function() 
            if mode == "auras" then storageProfilesOutfit.auraAtiva = id else storageProfilesOutfit.atual.id = id end
            salvarConfigOutfit()
        end
        w.btnFav.onClick = function() 
            if isFavorito(id) then for i, v in ipairs(storageProfilesOutfit.favoritos) do if v.id == id then table.remove(storageProfilesOutfit.favoritos, i) break end end
            else table.insert(storageProfilesOutfit.favoritos, {id = id}) end
            salvarConfigOutfit() refreshGrid()
        end
    end
end

outfitIcon.onMouseRelease = function(w, mPos, mBtn)
    if mBtn == 1 then
        storageProfilesOutfit.ativo = not storageProfilesOutfit.ativo
        w:setOn(storageProfilesOutfit.ativo)
        salvarConfigOutfit()
    elseif mBtn == 2 then
        outfitInterface:show()
        outfitInterface:raise()
        refreshGrid()
    end
    return true
end

outfitInterface.tabGallery.onClick = function() mode = "gallery" refreshGrid() end
outfitInterface.tabAuras.onClick = function() mode = "auras" refreshGrid() end
outfitInterface.tabFavs.onClick = function() mode = "favs" refreshGrid() end

