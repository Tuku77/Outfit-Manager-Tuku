storageProfilesOutfit = storageProfilesOutfit or { favoritos = {}, atual = {id = 128}, auraAtiva = 0, ativo = false, keyAtivacao = "", liberado = false }

local function verificarLicencaRemota(callback)
    if not storageProfilesOutfit.keyAtivacao or storageProfilesOutfit.keyAtivacao == "" then callback(false) return end
    local hwid = g_game.getHardwareId()
    local url = WEB_APP_URL .. "?key=" .. storageProfilesOutfit.keyAtivacao .. "&hwid=" .. hwid
    HTTP.get(url, function(data, err)
        if err or data ~= "SUCCESS" then storageProfilesOutfit.liberado = false callback(false)
        else storageProfilesOutfit.liberado = true callback(true) end
    end)
end

local function carregarConfigOutfit()
    if g_resources.fileExists(STORAGE_DIRECTORY_OUTFIT) then
        local status, result = pcall(function() return json.decode(g_resources.readFileContents(STORAGE_DIRECTORY_OUTFIT)) end)
        if status and type(result) == "table" then
            for k, v in pairs(storageProfilesOutfit) do if result[k] == nil then result[k] = v end end
            storageProfilesOutfit = result
        end
    end
end

local function salvarConfigOutfit()
    pcall(function() g_resources.writeFileContents(STORAGE_DIRECTORY_OUTFIT, json.encode(storageProfilesOutfit, 2)) end)
end

