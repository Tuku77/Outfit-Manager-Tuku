local mode = "gallery"
local filtroTexto = ""
local currentPage = 1

local function addOutfitToGrid(id)
    local widget = UI.createWidget("TukuStudioWidget", outfitInterface.itemScrollPanel)
    local tempOutfit = player:getOutfit()  
    
    -- Ajuste na pré-visualização: se o ID for uma aura manual (mesmo na aba favoritos), simula como aura
    if mode == "auras" or (mode == "favs" and isAuraManual(id)) then
        tempOutfit.aura = id
    else
        tempOutfit.type = id
        tempOutfit.aura = 0 
    end
    
    tempOutfit.addons = 3
    widget.creature:setOutfit(tempOutfit)
    widget.txtId:setText("ID: " .. id)
    widget.btnFav:setText(isFavorito(id) and "-" or "+")
    widget.btnFav:setColor(isFavorito(id) and "#ff5555" or "#55ff55")

    widget.select.onClick = function()
        if not verificarLicenca() then return end
        
        -- CORREÇÃO DA ABA DE FAVORITOS:
        -- Se estiver na aba Auras OU se estiver na aba Coleção e o ID for detectado como uma Aura Manual
        if mode == "auras" or (mode == "favs" and isAuraManual(id)) then 
            storageProfilesOutfit.auraAtiva = id 
        else 
            storageProfilesOutfit.atual.id = id 
        end
        salvarConfigOutfit()
    end

    widget.btnFav.onClick = function()
        if isFavorito(id) then
            for i, v in ipairs(storageProfilesOutfit.favoritos) do if v.id == id then table.remove(storageProfilesOutfit.favoritos, i) break end end
        else table.insert(storageProfilesOutfit.favoritos, {id = id}) end
        salvarConfigOutfit()
        refreshGrid()
    end
end

function refreshGrid()
    if not outfitInterface or not outfitInterface.itemScrollPanel then return end
    
    outfitInterface.itemScrollPanel:destroyChildren()
    local idsValidos = {}
    
    if mode == "gallery" then
        for i = 1, maxOutfits do 
            if not isAuraManual(i) then table.insert(idsValidos, i) end 
        end
    elseif mode == "auras" then
        for _, idAura in ipairs(listaAurasOrdenada) do table.insert(idsValidos, idAura) end
    else
        for _, v in ipairs(storageProfilesOutfit.favoritos) do table.insert(idsValidos, v.id) end
    end

    local idsFiltrados = {}
    for _, id in ipairs(idsValidos) do
        if filtroTexto == "" or tostring(id):find(filtroTexto) then
            table.insert(idsFiltrados, id)
        end
    end

    local totalItems = #idsFiltrados
    local maxPages = math.max(1, math.ceil(totalItems / ITEMS_PER_PAGE))
    
    if currentPage > maxPages then currentPage = maxPages end
    if currentPage < 1 then currentPage = 1 end

    if outfitInterface.lblPage then
        outfitInterface.lblPage:setText("Pagina: " .. currentPage .. "/" .. maxPages)
    end

    local startIndex = ((currentPage - 1) * ITEMS_PER_PAGE) + 1
    local endIndex = math.min(startIndex + ITEMS_PER_PAGE - 1, totalItems)

    for i = startIndex, endIndex do
        if idsFiltrados[i] then
            addOutfitToGrid(idsFiltrados[i])
        end
    end
end

outfitInterface.searchInput.onTextChange = function(w, t) filtroTexto = t:trim() currentPage = 1 refreshGrid() end
outfitInterface.tabGallery.onClick = function() mode = "gallery" currentPage = 1 refreshGrid() end
outfitInterface.tabAuras.onClick = function() mode = "auras" currentPage = 1 refreshGrid() end
outfitInterface.tabFavs.onClick = function() mode = "favs" currentPage = 1 refreshGrid() end
outfitInterface.closeButton.onClick = function() outfitInterface:hide() end

outfitInterface.btnPrev.onClick = function()
    if currentPage > 1 then
        currentPage = currentPage - 1
        refreshGrid()
    end
end

outfitInterface.btnNext.onClick = function()
    currentPage = currentPage + 1
    refreshGrid()
end

keyInterface.btnAtivar.onClick = function()
    local d = keyInterface.keyInput:getText():trim()
    if keysValidas[d] then storageProfilesOutfit.keyAtivacao = d salvarConfigOutfit() keyInterface:hide() refreshGrid()
    else modules.game_textmessage.displayFailureMessage("[ERRO] Chave Invalida") end
end

outfitIcon:setOn(storageProfilesOutfit.ativo)
outfitIcon.onMouseRelease = function(w, mPos, mBtn)
    if not verificarLicenca() then keyInterface:show() return true end
    if mBtn == 1 then storageProfilesOutfit.ativo = not storageProfilesOutfit.ativo w:setOn(storageProfilesOutfit.ativo) salvarConfigOutfit()
    elseif mBtn == 2 then outfitInterface:show() refreshGrid() end
    return true
end

macro(1, function()
    if not g_game.isOnline() or not verificarLicenca() or not storageProfilesOutfit.ativo then return end
    
    local outfit = player:getOutfit()
    local dOutfitId = tonumber(storageProfilesOutfit.atual.id) or 128
    local dAuraId = tonumber(storageProfilesOutfit.auraAtiva) or 0
    
    local mudouAlgo = false
    
    if outfit.type ~= dOutfitId then
        outfit.type = dOutfitId
        mudouAlgo = true
    end
    
    if outfit.aura > 0 then
        if dAuraId > 0 and outfit.aura ~= dAuraId then
            outfit.aura = dAuraId
            mudouAlgo = true
        end
    else
        if outfit.aura ~= 0 then
            outfit.aura = 0
            mudouAlgo = true
        end
    end
    
    if mudouAlgo then
        outfit.addons = 3
        player:setOutfit(outfit)
    end
end)
