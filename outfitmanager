local mode = "gallery"
local maxOutfits = 2176
local filtroTexto = ""

local function addOutfitToGrid(id)
    local widget = UI.createWidget("TukuStudioWidget", outfitInterface.itemScrollPanel)
    widget:setId("outfit_" .. id)
    
    local tempOutfit = player:getOutfit()  
    tempOutfit.type = id
    tempOutfit.addons = 3
    widget.creature:setOutfit(tempOutfit)
    
    widget.txtId:setText("ID: " .. id)

    if isFavorito(id) then
        widget.btnFav:setText("-")
        widget.btnFav:setColor("#ff5555")
    else
        widget.btnFav:setText("+")
        widget.btnFav:setColor("#55ff55")
    end

    widget.select.onClick = function()
        if not verificarLicenca() then return end
        storageProfilesOutfit.modoAleatorio = false
        btnRandomIcon:setOn(false)
        storageProfilesOutfit.atual.id = id
        salvarConfigOutfit()
    end

    widget.btnFav.onClick = function()
        if isFavorito(id) then
            for i, v in ipairs(storageProfilesOutfit.favoritos) do
                if v.id == id then
                    table.remove(storageProfilesOutfit.favoritos, i)
                    break
                end
            end
        else
            table.insert(storageProfilesOutfit.favoritos, {id = id})
        end
        salvarConfigOutfit()
        
        if mode == "favs" then
            refreshGrid()
        else
            if isFavorito(id) then
                widget.btnFav:setText("-")
                widget.btnFav:setColor("#ff5555")
            else
                widget.btnFav:setText("+")
                widget.btnFav:setColor("#55ff55")
            end
        end
    end
end

function refreshGrid()
    outfitInterface.itemScrollPanel:destroyChildren()

    if mode == "gallery" then
        if filtroTexto ~= "" then
            local targetId = tonumber(filtroTexto)
            if targetId and targetId >= 1 and targetId <= maxOutfits then
                addOutfitToGrid(targetId)
            end
            return
        end

        local currentId = 1
        local function carregarLote()
            if mode ~= "gallery" or filtroTexto ~= "" or not outfitInterface:isVisible() then return end
            local limite = math.min(currentId + 40, maxOutfits)
            for i = currentId, limite do
                addOutfitToGrid(i)
            end
            currentId = limite + 1
            if currentId <= maxOutfits then
                schedule(12, carregarLote)
            end
        end
        carregarLote()
    elseif mode == "favs" then
        local exibiuAlgum = false
        for _, fav in ipairs(storageProfilesOutfit.favoritos) do
            if filtroTexto == "" or tostring(fav.id):find(filtroTexto) then
                addOutfitToGrid(fav.id)
                exibiuAlgum = true
            end
        end

        if not exibiuAlgum then
            local label = UI.createWidget("Label", outfitInterface.itemScrollPanel)
            label:setText(filtroTexto == "" and "SUA COLECAO ESTA VAZIA" or "NENHUM FAVORITO ENCONTRADO")
            label:setColor("#888888")
        end
    end
end

outfitInterface.searchInput.onTextChange = function(widget, text)
    filtroTexto = text:trim()
    refreshGrid()
end

outfitInterface.tabGallery.onClick = function()
    mode = "gallery"
    refreshGrid()
end

outfitInterface.tabFavs.onClick = function()
    mode = "favs"
    refreshGrid()
end

outfitInterface.closeButton.onClick = function()
    outfitInterface:hide()
end

keyInterface.btnAtivar.onClick = function()
    local digitada = keyInterface.keyInput:getText():trim()
    if keysValidas[digitada] then
        storageProfilesOutfit.keyAtivacao = digitada
        salvarConfigOutfit()
        keyInterface:hide()
        outfitInterface:show()
        outfitInterface:raise()
        outfitInterface:focus()
        refreshGrid()
    else
        modules.game_textmessage.displayFailureMessage("[ERRO] Chave Invalida")
    end
end

outfitIcon:setOn(storageProfilesOutfit.ativo)
btnRandomIcon:setOn(storageProfilesOutfit.modoAleatorio)

-- Comportamento corrigido do BotSwitch do dado
btnRandomIcon.onClick = function(widget)
    if not verificarLicenca() then
        keyInterface:show()
        return true
    end
    storageProfilesOutfit.modoAleatorio = not storageProfilesOutfit.modoAleatorio
    widget:setOn(storageProfilesOutfit.modoAleatorio)
    salvarConfigOutfit()
end

outfitIcon.onMouseRelease = function(widget, mousePos, mouseButton)
    if mouseButton == 1 then
        if not verificarLicenca() then
            keyInterface:show()
            keyInterface:raise()
            keyInterface:focus()
            return true
        end
        storageProfilesOutfit.ativo = not storageProfilesOutfit.ativo
        widget:setOn(storageProfilesOutfit.ativo)
        salvarConfigOutfit()
    elseif mouseButton == 2 then
        if not verificarLicenca() then
            keyInterface:show()
            keyInterface:raise()
            keyInterface:focus()
            return true
        end
        outfitInterface:show()
        outfitInterface:raise()
        outfitInterface:focus()
        refreshGrid()
    end
    return true
end

-- ====================================================================
-- MOTOR SEGURO DE ATUALIZAÇÃO BASEADO EM CICLOS (1ms)
-- ====================================================================
local ciclosContador = 0

macro(1, function()
    if not g_game.isOnline() then return end
    if not verificarLicenca() then return end

    -- Sistema de rotação por contagem interna de ms pura (independente de os.time)
    if storageProfilesOutfit.ativo and storageProfilesOutfit.modoAleatorio then
        ciclosContador = ciclosContador + 1
        if ciclosContador >= 3000 then -- 3000 ms = 3 segundos exatos
            storageProfilesOutfit.atual.id = math.random(1, maxOutfits)
            ciclosContador = 0
        end
    else
        ciclosContador = 0
    end

    -- Aplica o visual no player
    if storageProfilesOutfit.ativo then
        local outfit = player:getOutfit()
        local desejadoId = tonumber(storageProfilesOutfit.atual.id) or 128
        if outfit and outfit.type ~= desejadoId then
            outfit.type = desejadoId
            outfit.addons = 3
            player:setOutfit(outfit)
        end
    end
end)

local directionCounter = 0
macro(500, function()
    if not outfitInterface:isVisible() then return end
    for _, c in ipairs(outfitInterface.itemScrollPanel:getChildren()) do    
        if c.creature then
            c.creature:setDirection(directionCounter)
        end
    end
    directionCounter = directionCounter + 1
    if directionCounter > 3 then directionCounter = 0 end
end)

if verificarLicenca() then
    refreshGrid()
end
