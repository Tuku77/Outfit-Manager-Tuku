local function addOutfitToGrid(id)
    local widget = UI.createWidget("TukuStudioWidget", outfitInterface.itemScrollPanel)
    widget:setId("outfit_" .. id)
    
    local tempOutfit = player:getOutfit()  
    tempOutfit.type = id
    tempOutfit.addons = 3
    widget.creature:setOutfit(tempOutfit)
    
    widget.txtId:setText("ID: " .. id)

    if isFavorito(id) then
        widget.btnFav:setText("-")
        widget.btnFav:setColor("#ff5555")
    else
        widget.btnFav:setText("+")
        widget.btnFav:setColor("#55ff55")
    end

    widget.select.onClick = function()
        if not verificarLicenca() then return end
        storageProfilesOutfit.atual.id = id
        salvarConfigOutfit()
    end

    widget.btnFav.onClick = function()
        if isFavorito(id) then
            for i, v in ipairs(storageProfilesOutfit.favoritos) do
                if v.id == id then
                    table.remove(storageProfilesOutfit.favoritos, i)
                    break
                end
            end
        else
            table.insert(storageProfilesOutfit.favoritos, {id = id})
        end
        salvarConfigOutfit()
        
        if mode == "favs" then
            refreshGrid()
        else
            if isFavorito(id) then
                widget.btnFav:setText("-")
                widget.btnFav:setColor("#ff5555")
            else
                widget.btnFav:setText("+")
                widget.btnFav:setColor("#55ff55")
            end
        end
    end
end

function refreshGrid()
    if mode == "esp" then return end
    outfitInterface.itemScrollPanel:destroyChildren()

    if mode == "gallery" then
        local currentId = 1
        local function carregarLote()
            if mode ~= "gallery" or not outfitInterface:isVisible() then return end
            local limite = math.min(currentId + 50, maxOutfits)
            for i = currentId, limite do
                addOutfitToGrid(i)
            end
            currentId = limite + 1
            if currentId <= maxOutfits then
                schedule(15, carregarLote)
            end
        end
        carregarLote()
    elseif mode == "favs" then
        if #storageProfilesOutfit.favoritos == 0 then
            local label = UI.createWidget("Label", outfitInterface.itemScrollPanel)
            label:setText("SUA COLECAO ESTA VAZIA")
            label:setColor("#888888")
            return
        end

        for _, fav in ipairs(storageProfilesOutfit.favoritos) do
            addOutfitToGrid(fav.id)
        end
    end
end

