    local d = keyInterface.keyInput:getText():trim()
    storageProfilesOutfit.keyAtivacao = d
    verificarLicencaRemota(function(ok)
        if ok then
            salvarConfigOutfit()
            keyInterface:hide()
            modules.game_textmessage.displayGameMessage("[Sucesso] Licenca validada!")
        else
            modules.game_textmessage.displayFailureMessage("[Erro] Chave invalida ou HWID incorreto.")
        end
    end)
