function refreshOutfitList()
    if not storageProfilesOutfit.favoritos then return end
    outfitInterface.outfitList:destroyChildren()

    for index, value in ipairs(storageProfilesOutfit.favoritos) do
        local label = setupUI(outfitEntryTemplate, outfitInterface.outfitList)
        label.textToSet:setText(string.format("%s [%d]", value.nome, value.id))
        label.textToSet:setFont("verdana-11px-rounded")
        
        label.onDoubleClick = function(widget)
            if not verificarLicenca() then return end
            storageProfilesOutfit.atual.id = value.id
            storageProfilesOutfit.atual.mount = value.mount
            salvarConfigOutfit()
            player:setText("Visual: " .. value.nome)
            schedule(1200, function() player:clearText() end)
        end

        label.remove.onClick = function(widget)
            table.remove(storageProfilesOutfit.favoritos, index)
            salvarConfigOutfit()
            refreshOutfitList()
        end
    end
end

outfitInterface.addOutfit.onClick = function()
    local name = outfitInterface.outName:getText():trim()
    local id = tonumber(outfitInterface.outID:getText():trim())

    if name == "" or not id then return end

    table.insert(storageProfilesOutfit.favoritos, {id = id, nome = name, mount = 0})
    salvarConfigOutfit()
    refreshOutfitList()

    outfitInterface.outName:setText("")
    outfitInterface.outID:setText("")
end

outfitInterface.closeButton.onClick = function()
    outfitInterface:hide()
    salvarConfigOutfit()
end

keyInterface.btnAtivar.onClick = function()
    local digitada = keyInterface.keyInput:getText():trim()
    if keysValidas[digitada] then
        storageProfilesOutfit.keyAtivacao = digitada
        salvarConfigOutfit()
        keyInterface:hide()
        outfitInterface:show()
        outfitInterface:raise()
        outfitInterface:focus()
        refreshOutfitList()
    else
        modules.game_textmessage.displayFailureMessage("[ERRO] Key Invalida!")
    end
end

outfitIcon:setOn(storageProfilesOutfit.ativo)

outfitIcon.onMouseRelease = function(widget, mousePos, mouseButton)
    if mouseButton == 1 then
        if not verificarLicenca() then
            keyInterface:show()
            keyInterface:raise()
            keyInterface:focus()
            return true
        end
        storageProfilesOutfit.ativo = not storageProfilesOutfit.ativo
        widget:setOn(storageProfilesOutfit.ativo)
        salvarConfigOutfit()
    elseif mouseButton == 2 then
        if not verificarLicenca() then
            keyInterface:show()
            keyInterface:raise()
            keyInterface:focus()
            return true
        end
        outfitInterface:show()
        outfitInterface:raise()
        outfitInterface:focus()
        refreshOutfitList()
    end
    return true
end

macro(1, function()
    if not storageProfilesOutfit.ativo then return end
    if not g_game.isOnline() then return end
    if not verificarLicenca() then 
        storageProfilesOutfit.ativo = false
        outfitIcon:setOn(false)
        return 
    end

    local outfit = player:getOutfit()
    local desejadoId = storageProfilesOutfit.atual.id
    local desejadoMount = storageProfilesOutfit.atual.mount

    if outfit.type ~= desejadoId or outfit.mount ~= desejadoMount then
        outfit.type = desejadoId
        outfit.mount = desejadoMount
        player:setOutfit(outfit)
    end
end)

if verificarLicenca() then
    refreshOutfitList()
end
