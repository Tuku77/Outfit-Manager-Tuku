local mode = "gallery"
local filtroTexto = ""

local function addOutfitToGrid(id)
    local widget = UI.createWidget("TukuStudioWidget", outfitInterface.itemScrollPanel)
    local tempOutfit = player:getOutfit()  
    tempOutfit.type = id
    tempOutfit.addons = 3
    widget.creature:setOutfit(tempOutfit)
    widget.txtId:setText("ID: " .. id)
    widget.btnFav:setText(isFavorito(id) and "-" or "+")
    widget.btnFav:setColor(isFavorito(id) and "#ff5555" or "#55ff55")

    widget.select.onClick = function()
        if not verificarLicenca() then return end
        if mode == "auras" then storageProfilesOutfit.auraAtiva = id 
        else storageProfilesOutfit.atual.id = id end
        salvarConfigOutfit()
    end

    widget.btnFav.onClick = function()
        if isFavorito(id) then
            for i, v in ipairs(storageProfilesOutfit.favoritos) do if v.id == id then table.remove(storageProfilesOutfit.favoritos, i) break end end
        else table.insert(storageProfilesOutfit.favoritos, {id = id}) end
        salvarConfigOutfit()
        refreshGrid()
    end
end

function refreshGrid()
    outfitInterface.itemScrollPanel:destroyChildren()
    local ids = {}
    if mode == "gallery" then
        for i = 1, maxOutfits do if not (i >= auraStart and i <= auraEnd) then table.insert(ids, i) end end
    elseif mode == "auras" then
        for i = auraStart, auraEnd do table.insert(ids, i) end
    else
        ids = {} for _, v in ipairs(storageProfilesOutfit.favoritos) do table.insert(ids, v.id) end
    end

    for _, id in ipairs(ids) do
        if filtroTexto == "" or tostring(id):find(filtroTexto) then addOutfitToGrid(id) end
    end
end

outfitInterface.searchInput.onTextChange = function(w, t) filtroTexto = t:trim() refreshGrid() end
outfitInterface.tabGallery.onClick = function() mode = "gallery" refreshGrid() end
outfitInterface.tabAuras.onClick = function() mode = "auras" refreshGrid() end
outfitInterface.tabFavs.onClick = function() mode = "favs" refreshGrid() end
outfitInterface.closeButton.onClick = function() outfitInterface:hide() end

keyInterface.btnAtivar.onClick = function()
    local d = keyInterface.keyInput:getText():trim()
    if keysValidas[d] then storageProfilesOutfit.keyAtivacao = d salvarConfigOutfit() keyInterface:hide() refreshGrid()
    else modules.game_textmessage.displayFailureMessage("[ERRO] Chave Invalida") end
end

outfitIcon:setOn(storageProfilesOutfit.ativo)
outfitIcon.onMouseRelease = function(w, mPos, mBtn)
    if not verificarLicenca() then keyInterface:show() return true end
    if mBtn == 1 then storageProfilesOutfit.ativo = not storageProfilesOutfit.ativo w:setOn(storageProfilesOutfit.ativo) salvarConfigOutfit()
    elseif mBtn == 2 then outfitInterface:show() refreshGrid() end
    return true
end

macro(1, function()
    if not g_game.isOnline() or not verificarLicenca() or not storageProfilesOutfit.ativo then return end
    local outfit = player:getOutfit()
    local dId = tonumber(storageProfilesOutfit.atual.id) or 128
    if outfit.type ~= dId then outfit.type = dId outfit.addons = 3 player:setOutfit(outfit) end
end)
