STORAGE_DIRECTORY_OUTFIT = MAIN_DIRECTORY .. 'profile_outfit_studio_' .. characterName .. '.json'

if not g_resources.directoryExists(MAIN_DIRECTORY) then g_resources.makeDir(MAIN_DIRECTORY) end

storageProfilesOutfit = storageProfilesOutfit or { favoritos = {}, atual = {id = 128}, auraAtiva = 0, ativo = false, keyAtivacao = "" }
local keysValidas = {["TUKU-CHAVE-MESTRA"] = true, ["TUKU-TESTE"] = true, ["NOVA-KEY-CLIENTE"] = true}
local auraStart, auraEnd, maxOutfits = 1000, 1100, 2176 

local function salvarConfigOutfit() pcall(function() g_resources.writeFileContents(STORAGE_DIRECTORY_OUTFIT, json.encode(storageProfilesOutfit, 2)) end) end
local function verificarLicenca() return keysValidas[storageProfilesOutfit.keyAtivacao] == true end
local function isFavorito(id) for _, v in ipairs(storageProfilesOutfit.favoritos) do if v.id == id then return true end end return false end

