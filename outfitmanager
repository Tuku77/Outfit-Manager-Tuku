MAIN_DIRECTORY = "/bot/" .. modules.game_bot.contentsPanel.config:getCurrentOption().text .. "/storage/"
local characterName = g_game.getCharacterName()
STORAGE_DIRECTORY_OUTFIT = MAIN_DIRECTORY .. 'profile_outfit_studio_' .. characterName .. '.json'

if not g_resources.directoryExists(MAIN_DIRECTORY) then
    g_resources.makeDir(MAIN_DIRECTORY)
end

storageProfilesOutfit = storageProfilesOutfit or {
    favoritos = {},
    atual = {id = 128},
    ativo = false,
    keyAtivacao = "",
    modoAleatorio = false
}

local keysValidas = {
    ["TUKU-CHAVE-MESTRA"] = true,
    ["TUKU-TESTE"] = true,
    ["NOVA-KEY-CLIENTE"] = true
}

local function carregarConfigOutfit()
    if g_resources.fileExists(STORAGE_DIRECTORY_OUTFIT) then
        local status, result = pcall(function()
            return json.decode(g_resources.readFileContents(STORAGE_DIRECTORY_OUTFIT))
        end)
        if status and type(result) == "table" then
            for k, v in pairs(storageProfilesOutfit) do
                if result[k] == nil then result[k] = v end
            end
            storageProfilesOutfit = result
        end
    end
end

local function salvarConfigOutfit()
    pcall(function()
        local content = json.encode(storageProfilesOutfit, 2)
        g_resources.writeFileContents(STORAGE_DIRECTORY_OUTFIT, content)
    end)
end

carregarConfigOutfit()

local function verificarLicenca()
    return keysValidas[storageProfilesOutfit.keyAtivacao] == true
end

local function isFavorito(id)
    for _, v in ipairs(storageProfilesOutfit.favoritos) do
        if v.id == id then return true end
    end
    return false
end

