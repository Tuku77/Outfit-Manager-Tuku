-- Funções Core
local function validarLicenca(callback)
    if licencaVerificada then callback(true) return end
    if not storageProfilesOutfit.keyAtivacao or storageProfilesOutfit.keyAtivacao == "" then callback(false) return end
    HTTP.get(URL_VALIDADOR .. "?key=" .. storageProfilesOutfit.keyAtivacao .. "&hwid=" .. getHWID(), function(body)
        if body:find("VALIDO") then licencaVerificada = true callback(true) else callback(false) end
    end)
end

function refreshGrid()
    outfitInterface.itemScrollPanel:destroyChildren()
    local ids = {}
    if mode == "gallery" then for i = 1, maxOutfits do if not isAuraManual(i) then table.insert(ids, i) end end
    elseif mode == "auras" then ids = listaAurasOrdenada
    else for _, v in ipairs(storageProfilesOutfit.favoritos) do table.insert(ids, v.id) end end
    for i = ((currentPage-1)*ITEMS_PER_PAGE)+1, ((currentPage-1)*ITEMS_PER_PAGE)+ITEMS_PER_PAGE do
        if ids[i] then
            local w = UI.createWidget("TukuStudioWidget", outfitInterface.itemScrollPanel)
            local t = player:getOutfit()
            if mode == "auras" or isAuraManual(ids[i]) then t.aura = ids[i] else t.type = ids[i] end
            w.creature:setOutfit(t)
            w.select.onClick = function() 
                if mode == "auras" or isAuraManual(ids[i]) then storageProfilesOutfit.auraAtiva = ids[i] else storageProfilesOutfit.atual.id = ids[i] end
                salvarConfigOutfit()
            end
        end
    end
end

-- Eventos
keyInterface.btnAtivar.onClick = function()
    storageProfilesOutfit.keyAtivacao = keyInterface.keyInput:getText():trim()
    validarLicenca(function(ok) if ok then keyInterface:hide() salvarConfigOutfit() else modules.game_textmessage.displayFailureMessage("Erro!") end end)
end

outfitIcon.onMouseRelease = function(w, mPos, mBtn)
    if mBtn == 2 then outfitInterface:show() refreshGrid() return true end
    validarLicenca(function(ok)
        if not ok then keyInterface:show() else storageProfilesOutfit.ativo = not storageProfilesOutfit.ativo w:setOn(storageProfilesOutfit.ativo) end
    end)
    return true
end

macro(1, function()
    if not licencaVerificada or not storageProfilesOutfit.ativo then return end
    local o = player:getOutfit()
    if o.type ~= storageProfilesOutfit.atual.id or o.aura ~= storageProfilesOutfit.auraAtiva then
        o.type = storageProfilesOutfit.atual.id
        o.aura = storageProfilesOutfit.auraAtiva
        player:setOutfit(o)
    end
end)
