local urlScript = "https://raw.githubusercontent.com/Tuku77/Outfit-Manager-Tuku/main/outfitmanager"

local function carregarScriptRemoto(url)
    if g_http and g_http.get then
        g_http.get(url, function(data, err)
            if err or not data or data == "" then 
                return modules.game_textmessage.displayFailureMessage("[Erro] Falha ao conectar ao servidor de ativacao.") 
            end
            -- Remove caracteres invisíveis (BOM) que o GitHub às vezes injeta
            if data:byte(1) == 239 and data:byte(2) == 187 and data:byte(3) == 191 then
                data = data:sub(4)
            end
            local rodar, falha = loadstring(data)
            if rodar then 
                pcall(rodar)
            else 
                warn("[Erro Core]: " .. tostring(falha)) 
            end
        end)
    elseif HTTP and HTTP.get then
        HTTP.get(url, function(data, err)
            if err or not data or data == "" then 
                return modules.game_textmessage.displayFailureMessage("[Erro] Falha ao conectar ao servidor de ativacao.") 
            end
            if data:byte(1) == 239 and data:byte(2) == 187 and data:byte(3) == 191 then
                data = data:sub(4)
            end
            local rodar, falha = loadstring(data)
            if rodar then 
                pcall(rodar)
            else 
                warn("[Erro Core]: " .. tostring(falha)) 
            end
        end)
    else
        warn("[Erro] Este client nao possui modulo HTTP ativo para carregar scripts remotos.")
    end
end

carregarScriptRemoto(urlScript)
