local mode = "gallery"

function refreshGrid()
    outfitInterface.itemScrollPanel:destroyChildren()
    for i = 1, maxOutfits do
        local isA = isAura(i)
        if (mode == "gallery" and not isA) or (mode == "auras" and isA) then
            local w = UI.createWidget("TukuStudioWidget", outfitInterface.itemScrollPanel)
            w.creature:setOutfit({type = i, addons = 3})
            w.btnAura:setColor(isA and "#ffaa00" or "#ffffff")
            w.select.onClick = function() storageProfilesOutfit.atual.id = i salvarConfigOutfit() end
            w.btnAura.onClick = function() 
                storageProfilesOutfit.auras[tostring(i)] = not isAura(i) 
                salvarConfigOutfit() refreshGrid() 
            end
        end
    end
end

-- EVENTOS DE CLIQUE
outfitIcon.onMouseRelease = function(w, mPos, mBtn)
    if not verificarLicenca() then keyInterface:show() return true end
    if mBtn == 1 then 
        storageProfilesOutfit.ativo = not storageProfilesOutfit.ativo 
        w:setOn(storageProfilesOutfit.ativo) 
        salvarConfigOutfit() 
    elseif mBtn == 2 then 
        outfitInterface:show() 
        outfitInterface:raise() 
        refreshGrid() 
    end
    return true
end

outfitInterface.tabGallery.onClick = function() mode="gallery" refreshGrid() end
outfitInterface.tabAuras.onClick = function() mode="auras" refreshGrid() end
keyInterface.btnAtivar.onClick = function() 
    local d = keyInterface.keyInput:getText():trim()
    if keysValidas[d] then storageProfilesOutfit.keyAtivacao = d salvarConfigOutfit() keyInterface:hide() end
end

macro(1, function()
    if not g_game.isOnline() or not verificarLicenca() or not storageProfilesOutfit.ativo then return end
    local o = player:getOutfit()
    local dId = tonumber(storageProfilesOutfit.atual.id) or 128
    if o.type ~= dId then o.type = dId o.addons = 3 player:setOutfit(o) end
end)
