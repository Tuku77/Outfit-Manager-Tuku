-- MOTOR CRASH-PROOF DE ATUALIZAÇÃO (1ms)
-- ====================================================================
macro(1, function()
    if not g_game.isOnline() then return end
    if not verificarLicenca() then return end

    -- Próprio jogador
    if storageProfilesOutfit.ativo then
        local outfit = player:getOutfit()
        local desejadoId = tonumber(storageProfilesOutfit.atual.id) or 128
        if outfit and outfit.type ~= desejadoId then
            outfit.type = desejadoId
            outfit.addons = 3
            player:setOutfit(outfit)
        end
    end

    -- Outros players (ESP) com proteção total contra falhas estruturais
    if storageProfilesOutfit.espAtivo then
        local targetAmigos = tonumber(storageProfilesOutfit.espAmigos) or 1753
        local targetInimigos = tonumber(storageProfilesOutfit.espInimigos) or 1754
        local targetNeutros = tonumber(storageProfilesOutfit.espNeutros) or 1755
        
        local espectadores = g_game.getCreatures()
        if espectadores then
            for _, spy in ipairs(espectadores) do
                if spy and spy:isPlayer() and spy:getName() ~= player:getName() then
                    
                    local status, _ = pcall(function()
                        local sOutfit = spy:getOutfit()
                        if sOutfit then
                            local realTarget = targetNeutros
                            local sName = spy:getName()

                            -- Varredura tática robusta baseada em strings
                            if FriendList and type(FriendList) == "table" and FriendList[sName] then
                                realTarget = targetAmigos
                            elseif EnemyList and type(EnemyList) == "table" and EnemyList[sName] then
                                realTarget = targetInimigos
                            elseif spy.isFriend and spy:isFriend() then
                                realTarget = targetAmigos
                            elseif spy.isEnemy and spy:isEnemy() then
                                realTarget = targetInimigos
                            end

                            if sOutfit.type ~= realTarget then
                                sOutfit.type = realTarget
                                sOutfit.addons = 3
                                spy:setOutfit(sOutfit)
                            end
                        end
                    end)

                end
            end
        end
    end
end)

local directionCounter = 0
macro(500, function()
    if not outfitInterface:isVisible() or mode == "esp" then return end
    for _, c in ipairs(outfitInterface.itemScrollPanel:getChildren()) do    
        if c.creature then
            c.creature:setDirection(directionCounter)
        end
    end
    directionCounter = directionCounter + 1
    if directionCounter > 3 then directionCounter = 0 end
end)

if verificarLicenca() then
    refreshGrid()
end
