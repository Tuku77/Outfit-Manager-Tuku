local mode = "gallery"
local filtroTexto = ""

local function addWidget(id)
    local w = UI.createWidget("TukuStudioWidget", outfitInterface.itemScrollPanel)
    local outfit = player:getOutfit() outfit.type = id outfit.addons = 3
    w.creature:setOutfit(outfit)
    w.txtId:setText("ID: " .. id)
    w.btnFav:setText(isFavorito(id) and "-" or "+")
    w.btnAura:setColor(isAura(id) and "#ffaa00" or "#ffffff")
    w.select.onClick = function() storageProfilesOutfit.atual.id = id salvarConfigOutfit() end
    w.btnFav.onClick = function() 
        if isFavorito(id) then for i,v in ipairs(storageProfilesOutfit.favoritos) do if v.id==id then table.remove(storageProfilesOutfit.favoritos, i) break end end
        else table.insert(storageProfilesOutfit.favoritos, {id=id}) end
        salvarConfigOutfit() refreshGrid() 
    end
    w.btnAura.onClick = function()
        storageProfilesOutfit.auras[tostring(id)] = not isAura(id)
        w.btnAura:setColor(isAura(id) and "#ffaa00" or "#ffffff")
        salvarConfigOutfit()
    end
end

function loadBatch()
    local count = 0
    local start = (currentBatch - 1) * batchSize + 1
    for i = start, maxOutfits do
        if count >= batchSize then break end
        local isA = isAura(i)
        local show = (mode == "gallery" and not isA) or (mode == "auras" and isA) or (mode == "favs" and isFavorito(i))
        if show and (filtroTexto == "" or tostring(i):find(filtroTexto)) then addWidget(i) count = count + 1 end
    end
    currentBatch = currentBatch + 1
end

function refreshGrid()
    outfitInterface.itemScrollPanel:destroyChildren()
    currentBatch = 1
    loadBatch()
end

-- EVENTOS DE CLIQUE RESTAURADOS
keyInterface.btnAtivar.onClick = function()
    local d = keyInterface.keyInput:getText():trim()
    if keysValidas[d] then storageProfilesOutfit.keyAtivacao = d salvarConfigOutfit() keyInterface:hide() refreshGrid()
    else modules.game_textmessage.displayFailureMessage("[ERRO] Chave Invalida") end
end

outfitIcon:setOn(storageProfilesOutfit.ativo)
outfitIcon.onMouseRelease = function(w, mPos, mBtn)
    if not verificarLicenca() then keyInterface:show() keyInterface:raise() keyInterface:focus() return true end
    if mBtn == 1 then storageProfilesOutfit.ativo = not storageProfilesOutfit.ativo w:setOn(storageProfilesOutfit.ativo) salvarConfigOutfit
