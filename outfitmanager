MAIN_DIRECTORY = "/bot/" .. modules.game_bot.contentsPanel.config:getCurrentOption().text .. "/storage/"
local characterName = g_game.getCharacterName()
STORAGE_DIRECTORY_OUTFIT = MAIN_DIRECTORY .. 'profile_outfit_studio_' .. characterName .. '.json'

if not g_resources.directoryExists(MAIN_DIRECTORY) then g_resources.makeDir(MAIN_DIRECTORY) end

storageProfilesOutfit = storageProfilesOutfit or { favoritos = {}, auras = {}, atual = {id = 128}, ativo = false, keyAtivacao = "" }
local keysValidas = {["TUKU-CHAVE-MESTRA"] = true, ["TUKU-TESTE"] = true, ["NOVA-KEY-CLIENTE"] = true}
local maxOutfits = 2176 
local currentBatch = 1
local batchSize = 40
local saveTimer = nil

local function carregarConfigOutfit()
    if g_resources.fileExists(STORAGE_DIRECTORY_OUTFIT) then
        local status, result = pcall(function() return json.decode(g_resources.readFileContents(STORAGE_DIRECTORY_OUTFIT)) end)
        if status and type(result) == "table" then
            for k, v in pairs(storageProfilesOutfit) do if result[k] == nil then result[k] = v end end
            storageProfilesOutfit = result
        end
    end
end

local function salvarConfigOutfit()
    if saveTimer then saveTimer:cancel() end
    saveTimer = schedule(2000, function()
        pcall(function() g_resources.writeFileContents(STORAGE_DIRECTORY_OUTFIT, json.encode(storageProfilesOutfit, 2)) end)
    end)
end
carregarConfigOutfit()

local function isAura(id) return storageProfilesOutfit.auras[tostring(id)] == true end
local function isFavorito(id) for _, v in ipairs(storageProfilesOutfit.favoritos) do if v.id == id then return true end end return false end
local function verificarLicenca() return keysValidas[storageProfilesOutfit.keyAtivacao] == true end

